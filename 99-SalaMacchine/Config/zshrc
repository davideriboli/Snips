# =============================================================================
# 1. ZSH CORE CONFIGURATION
# =============================================================================
# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
ZSH_THEME="powerlevel10k/powerlevel10k"

# Disable auto-setting terminal title.
DISABLE_AUTO_TITLE="true"

# Enable command auto-correction.
ENABLE_CORRECTION="true"

# Display red dots whilst waiting for completion.
COMPLETION_WAITING_DOTS="true"

# Disable marking untracked files as dirty.
DISABLE_UNTRACKED_FILES_DIRTY="true"

# History timestamp format
HIST_STAMPS="mm/dd/yyyy"

# =============================================================================
# 2. PLUGINS
# =============================================================================
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# =============================================================================
# 3. USER CONFIGURATION
# =============================================================================
# Editor impostato su Gedit. 
# --wait è fondamentale: dice al terminale di aspettare che tu chiuda Gedit 
# prima di continuare (essenziale per i commit di git).
export EDITOR='gedit --wait'
export VISUAL='gedit --wait'

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"

# Aliases
alias zshconfig="gedit ~/.zshrc"
alias ohmyzsh="gedit ~/.oh-my-zsh"
alias ll="ls -lah"
alias update="update-all" 

# =============================================================================
# 4. POWERLEVEL10K CONFIGURATION
# =============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# =============================================================================
# 5. CUSTOM FUNCTIONS (MSI VECTOR OPTIMIZATION)
# =============================================================================

# --- Update-All: System, AUR & Flatpak ---
update-all() {
    echo "🔥 Stormy, avvio procedura di aggiornamento globale..."

    # 1. Core System & AUR
    echo ":: [1/3] Sync Arch Repos & AUR..."
    yay -Syu

    # 2. Flatpak (con check di esistenza)
    if command -v flatpak >/dev/null 2>&1; then
        echo ":: [2/3] Updating Flatpaks..."
        flatpak update -y
    fi

    # 3. Pulizia Cache & Orfani
    echo ":: [3/3] Cleaning house..."
    yay -Yc --noconfirm

    echo "✅ Sistema aggiornato e pronto."
}

# --- Clean-All: System Deep Clean ---
clean-all() {
    echo "🧹 Stormy, inizio pulizia profonda del sistema..."

    # 1. Rimozione Orfani
    echo ":: [1/4] Rimozione dipendenze orfane (Arch/AUR)..."
    yay -Yc --noconfirm

    # 2. Pulizia Cache Intelligente
    echo ":: [2/4] Rimozione cache dei disinstallati..."
    sudo paccache -ruk0
    
    echo ":: [3/4] Ottimizzazione cache pacchetti installati..."
    sudo paccache -rk2

    # 3. Pulizia Flatpak
    if command -v flatpak >/dev/null 2>&1; then
        echo ":: [4/4] Pulizia Runtimes Flatpak inutilizzati..."
        flatpak uninstall --unused -y
    fi

    # 4. Pulizia Journal
    sudo journalctl --vacuum-time=7d

    echo "✨ Sistema pulito e ottimizzato."
}

# =============================================================================
# 6. FINAL OUTPUT
# =============================================================================
# Forza la stampa su stdout ignorando eventuali blocchi di P10k
echo ""
/usr/bin/fortune oblique-strategies
echo ""

fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select

# Created by `pipx` on 2026-02-10 16:28:50
export PATH="$PATH:/home/stormy/.local/bin"

# =============================================================================
# 7. GRAFANA ON DEMAND MODULE
# =============================================================================

export GRAFANA_PATH="/run/media/stormy/Data/Code/Grafana"

grafana-up() {
    echo "[+] Awakening Docker Engine..."
    sudo systemctl start docker
    
    # Check se il disco è montato
    if [ ! -d "$GRAFANA_PATH" ]; then
        echo "[!] ERRORE: Il path $GRAFANA_PATH non esiste. Disco 'Data' montato?"
        return 1
    fi

    cd "$GRAFANA_PATH"
    echo "[+] Launching Grafana Stack..."
    docker compose up -d
    echo "[+] Mission successful. Grafana: http://localhost:3000 (admin/admin)"
}

grafana-down() {
    echo "[-] Tearing down containers..."
    if [ -d "$GRAFANA_PATH" ]; then
        cd "$GRAFANA_PATH" && docker compose down
    else
        echo "[!] Avviso: Cartella del progetto non trovata, salto lo stop dei container."
    fi
    
    echo "[-] Stopping Docker and cleaning sockets..."
    sudo systemctl stop docker.service docker.socket
    echo "[!] System is now clean. Resources freed."
}

# Comando rapido per la sincronizzazione (accetta --days come argomento)
grafana-sync() {
    if [ -d "$GRAFANA_PATH" ]; then
        cd "$GRAFANA_PATH"
        ./VEnv/bin/python scripts/sync_garmin.py "$@"
    else
        echo "[!] ERRORE: Path $GRAFANA_PATH non trovato."
    fi
}
